{
  "version": "ebir-r2-full-reviewer-tasks-v1",
  "created": "2026-06-19",
  "freeze_status": "frozen_for_full_r2_preflight",
  "description": "Expanded synthetic sanitized EBIR-R2 reviewer-task corpus for the full condition-masked human-review trial setup. This corpus preserves the pilot packet schema, reviewer wording, response fields, and three-condition structure.",
  "promotion_status": "blocked_from_authoritative_resolution_promotion",
  "conditions": [
    "raw_evidence",
    "one_pass_reconciliation",
    "ebir_refinement"
  ],
  "reviewer_task_schema": {
    "required_packet_fields": [
      "packet_id",
      "reviewer_id",
      "case_blind_id",
      "condition_blind_id",
      "task",
      "parent_evidence",
      "candidate",
      "reviewer_questions",
      "scoring_rubric"
    ],
    "required_candidate_fields": [
      "provided",
      "status",
      "resolved_value",
      "summary",
      "confidence",
      "uncertainty_notes",
      "parent_support_map",
      "claim_support"
    ]
  },
  "blinding_rules": {
    "remove_condition_labels": true,
    "remove_gold_labels": true,
    "remove_ebir_internals": true,
    "deterministic_seed_required": true
  },
  "assignment_rules": {
    "min_reviewers": 3,
    "no_reviewer_same_case_twice": true,
    "balance_conditions_across_reviewers": true
  },
  "reviewer_questions": [
    {
      "id": "correct_resolution",
      "prompt": "Is the resolution or abstention decision correct given the evidence?",
      "scale": "0_2"
    },
    {
      "id": "evidence_supported",
      "prompt": "Are all claims supported by the parent evidence?",
      "scale": "0_2"
    },
    {
      "id": "abstention_or_escalation",
      "prompt": "Does the packet correctly abstain or escalate when evidence is insufficient?",
      "scale": "0_2"
    },
    {
      "id": "unsupported_claim_detection",
      "prompt": "Are unsupported claims absent or clearly identified?",
      "scale": "0_2"
    },
    {
      "id": "uncertainty_clarity",
      "prompt": "Is remaining uncertainty clear enough for human review?",
      "scale": "0_2"
    },
    {
      "id": "reviewer_confidence",
      "prompt": "How confident are you in your review judgment?",
      "scale": "1_5"
    },
    {
      "id": "synthesized_recommendation_impression",
      "prompt": "Did this packet appear to include a synthesized recommendation?",
      "scale": "yes_no_unsure"
    },
    {
      "id": "synthesized_recommendation_impression_confidence",
      "prompt": "How confident are you in that impression?",
      "scale": "1_5"
    }
  ],
  "scoring_rubric": {
    "0": "Incorrect, unsupported, misleading, or unsafe.",
    "1": "Partially correct but incomplete, unclear, or weakly supported.",
    "2": "Correct, evidence-supported, appropriately cautious, and reviewable.",
    "confidence_1_5": "1 is very low confidence; 5 is very high confidence.",
    "yes_no_unsure": "Use Yes, No, or Unsure without inferring or labeling the study condition."
  },
  "acceptance_criteria": {
    "preflight": [
      "all_cases_have_three_conditions",
      "identical_parent_evidence_across_conditions",
      "gold_absent_from_reviewer_packets",
      "condition_and_ebir_internals_removed",
      "no_reviewer_same_case_twice",
      "balanced_condition_assignment",
      "normalized_packet_schema",
      "ebir_shadow_only",
      "no_runtime_or_memory_writes"
    ]
  },
